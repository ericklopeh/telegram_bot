# =============================================================================
# Sistema Gaman — plantilla de variables (.env)
# Copiar:  cp .env.example .env   (nunca subir .env con secretos reales)
# =============================================================================

# --- Entorno / operación (P30) ---
ENVIRONMENT=development
# development | staging | production
LOG_LEVEL=INFO
APP_VERSION=0.1.0
# Raíz de archivos (dentro del contenedor suele ser /app/storage)
STORAGE_ROOT=/app/storage
BASE_STORAGE_PATH=/app/storage
# Demo interna: relaja RBAC y comportamientos de prueba (no usar en producción)
DEMO_MODE=false
# P34 — confirmaciones textuales y límites en recovery (staging/beta interna)
BETA_SAFE_MODE=false

# --- Telegram ---
TELEGRAM_BOT_TOKEN=replace-me
SEMANA_ACTIVA_AUTO=true
#SEMANA_ACTIVA=SEM 17-2026

# --- PostgreSQL ---
POSTGRES_DB=telegram_bot
POSTGRES_USER=telegram_user
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

# SQLAlchemy (host `db` dentro de Docker; `localhost:5433` desde Windows con compose dev)
DATABASE_URL=postgresql+psycopg://telegram_user:replace-me@db:5432/telegram_bot

# --- Web ---
WEB_SESSION_SECRET=replace-with-a-long-random-secret-min-32-chars
# Puerto host servicio web (solo docker-compose.yml dev)
#WEB_HOST_PORT=8010
# Puerto HTTP nginx en staging (docker-compose.staging.yml)
#NGINX_HTTP_PORT=8080
# WEB_DEBUG=true solo en desarrollo local (muestra traceback en 500)
WEB_DEBUG=false
# false en staging/producción; true solo para pruebas locales
WEB_RBAC_RELAXED=false
#TELEGRAM_DEV_FALLBACK_ANY_SENDER=false

# --- Rutas storage (opcional) ---
PEDIDOS_PATH=/app/storage/pedidos
REVISIONES_PATH=/app/storage/revisiones
#RUTA_BASE_PEDIDOS=
#RUTA_BASE_REVISIONES=

# --- Microsoft Graph / SharePoint ---
MS_TENANT_ID=replace-me
MS_CLIENT_ID=replace-me
MS_CLIENT_SECRET=replace-me
MS_SITE_HOSTNAME=your-tenant.sharepoint.com
MS_SITE_PATH=/sites/your-site
MS_SITE_ID=
MS_DRIVE_NAME=
MS_DRIVE_ID=
MS_ROOT_FOLDER=Mi unidad/ruta/pedidos

# --- Graph tuning (opcional) ---
SHAREPOINT_RETRY_INTERVAL_MINUTES=5
SHAREPOINT_RETRY_MAX_ATTEMPTS=8
MS_GRAPH_MAX_RETRIES=5
MS_GRAPH_RETRY_BASE_SECONDS=1.0
MS_GRAPH_UPLOAD_CHUNK_BYTES=3276800
MS_GRAPH_REQUEST_TIMEOUT=30
MS_GRAPH_UPLOAD_TIMEOUT=120
MS_GRAPH_SMALL_FILE_MAX_BYTES=4194304

# --- Chats / SLA (opcional) ---
CHAT_ID_PEDIDOS=0
CHAT_ID_COMPULSAS=0
CHAT_ID_ADMIN_ALERTS=0
COMPULSA_REMINDER_MINUTES=60
SELLER_USER_IDS=
ADMIN_USER_IDS=
DISPLAY_TIMEZONE=America/Mexico_City
BUSINESS_HOURS_ENABLED=false
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=18:30
SLA_ALERT_INTERVAL_MINUTES=120
SLA_REVISION_MINUTES=240
SLA_AUTORIZACION_MINUTES=240
SLA_COMPULSA_MINUTES=180
OPERATIONAL_ALERTS_TELEGRAM=false

# --- P36-P45 plataforma ---
REDIS_URL=
# En producción con compose prod: redis://redis:6379/0
JOBS_ASYNC_ENABLED=true
SLOW_QUERY_MS=500
CACHE_TTL_SECONDS=60
API_RATE_LIMIT_PER_MIN=120

# --- P70 producción / VPS ---
# SENTRY_DSN=https://xxx@o000.ingest.sentry.io/000
METRICS_ENABLED=true
SECURE_COOKIES=true
MAX_UPLOAD_BYTES=134217728
BACKUP_RETENTION_DAYS=14
TRUSTED_PROXY=false
# Worker/scheduler (compose --profile with-worker)
WORKER_POLL_SECONDS=15
SCHEDULER_INTERVAL_SEC=3600
SCHEDULER_ENABLED=false
