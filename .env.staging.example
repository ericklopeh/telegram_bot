# =============================================================================
# Sistema Gaman — plantilla STAGING (sin secretos reales)
# Copiar:  cp .env.staging.example .env
# Uso:     docker compose -f docker-compose.staging.yml --env-file .env up -d
# =============================================================================

ENVIRONMENT=staging
LOG_LEVEL=INFO
APP_VERSION=0.1.0
STORAGE_ROOT=/app/storage
BASE_STORAGE_PATH=/app/storage
DEMO_MODE=false
BETA_SAFE_MODE=false

# --- Telegram (obligatorio para arranque Settings) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
SEMANA_ACTIVA_AUTO=true
TELEGRAM_DEV_FALLBACK_ANY_SENDER=false

# --- PostgreSQL (servicio `db` en compose staging) ---
POSTGRES_DB=gaman_staging
POSTGRES_USER=gaman_staging
POSTGRES_PASSWORD=change_me_staging_db_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://gaman_staging:change_me_staging_db_password@db:5432/gaman_staging

# --- Web staging ---
WEB_SESSION_SECRET=change-me-staging-secret-min-32-characters
NGINX_HTTP_PORT=8080
WEB_DEBUG=false
WEB_RBAC_RELAXED=false

PEDIDOS_PATH=/app/storage/pedidos
REVISIONES_PATH=/app/storage/revisiones

# --- Microsoft Graph / SharePoint ---
MS_TENANT_ID=your-tenant-id
MS_CLIENT_ID=your-client-id
MS_CLIENT_SECRET=your-client-secret
MS_SITE_HOSTNAME=your-tenant.sharepoint.com
MS_SITE_PATH=/sites/your-site
MS_SITE_ID=
MS_DRIVE_NAME=
MS_DRIVE_ID=
MS_ROOT_FOLDER=Mi unidad/ruta/pedidos

# --- Chats / SLA (opcional) ---
CHAT_ID_PEDIDOS=0
CHAT_ID_COMPULSAS=0
CHAT_ID_ADMIN_ALERTS=0
DISPLAY_TIMEZONE=America/Mexico_City
OPERATIONAL_ALERTS_TELEGRAM=false

# --- Plataforma (opcional staging) ---
REDIS_URL=
JOBS_ASYNC_ENABLED=true
API_RATE_LIMIT_PER_MIN=120
METRICS_ENABLED=true
SECURE_COOKIES=false
TRUSTED_PROXY=false
